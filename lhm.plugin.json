                      "maximum": 9007199254740991
                    },
                    "monthly_cents": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "monthly": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "months",
