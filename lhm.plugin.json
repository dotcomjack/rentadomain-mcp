    "domain rental",
    "dns",
    "agents"
  ],
  "tools": [
    {
      "name": "search_names",
      "title": "Search listed names",
      "description": "Lists the domain names rentadomain.sh has for rent right now, each with its monthly price and term menu; call it first, or whenever the user wants a domain and has not named one. Pass the user's own words as the query: names are matched on their host and keywords and ranked by how many words they match, and a miss returns the names closest in spelling.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "description": "The person's words for the name they want (a sentence works) or a piece of a host; empty or absent lists every name.",
            "type": "string",
            "maxLength": 64
          },
          "limit": {
            "default": 20,
            "description": "How many names to return, 1 to 50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "names": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                },
                "monthly_cents": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "monthly": {
                  "type": "string"
                },
                "term_menu": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "months": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "monthly_cents": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "monthly": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "months",
                      "monthly_cents",
                      "monthly"
                    ],
                    "additionalProperties": false
                  }
                },
                "url": {
                  "type": "string"
                },
                "rent_url": {
                  "type": "string"
                },
                "matched": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "host",
                "monthly_cents",
                "monthly",
                "term_menu",
                "url",
                "rent_url",
                "matched"
              ],
              "additionalProperties": false
            }
          },
          "closest": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                },
                "monthly_cents": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "monthly": {
                  "type": "string"
                },
                "term_menu": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "months": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "monthly_cents": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "monthly": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "months",
                      "monthly_cents",
                      "monthly"
                    ],
                    "additionalProperties": false
                  }
                },
                "url": {
                  "type": "string"
                },
                "rent_url": {
                  "type": "string"
                }
              },
              "required": [
                "host",
                "monthly_cents",
                "monthly",
                "term_menu",
                "url",
                "rent_url"
              ],
              "additionalProperties": false
            }
          },
          "closest_why": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "query",
          "total",
          "names",
          "closest",
          "closest_why"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Search listed names",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
