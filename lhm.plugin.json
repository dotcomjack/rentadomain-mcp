{
  "identifier": "rentadomain",
  "name": "rentadomain.sh",
  "version": "1.0.1",
  "author": "rentadomain.sh",
  "description": "Rent a domain by the month, never sold. Search the listed names, see each term and its total, and start a rent your person approves.",
  "homepage": "https://rentadomain.sh/for-agents",
  "cloudEndpoint": "https://rentadomain.sh/mcp",
