    {
      "name": "start_rent",
      "title": "Start a rent",
      "description": "Starts renting one listed name for a term (12, 6 or 1 month) and returns an approval_url for the human to open: they sign in (an email code, then a passkey or authenticator app), pass the identity check, sign the lease and pay by card, and the fixed-term lease starts on payment with no refunds after activation; names are rented for business or other commercial use only. Call it once the user has chosen the name and term. A rented or unheld name answers taken or not_listed with listed alternatives; a mandate (pre-authorized agent rent) is not available yet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "The domain name as the user gave it: a URL or a bare host both work."
          },
          "term_months": {
            "default": 12,
            "description": "The term: 12, 6 or 1 month. The 12 month rate is the listed rate; shorter terms cost more per month.",
            "type": "number",
            "enum": [
              12,
              6,
              1
            ]
          },
          "client": {
            "description": "The agent platform or client, free text, recorded on the intent.",
            "type": "string",
            "maxLength": 64
          },
          "mandate": {
            "description": "A pre-authorization from the human for an agent-completed rent. Not available yet: the answer is mandate_unavailable and approval_url still works.",
            "type": "object",
            "properties": {
              "max_monthly_cents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The most per month the human pre-authorized, in cents."
              },
              "max_term_months": {
                "type": "number",
                "enum": [
                  12,
                  6,
                  1
                ],
                "description": "The longest term the human pre-authorized: 12, 6 or 1 month."
              },
              "authorization_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "The id of the authorization the human recorded."
              }
            },
            "required": [
              "max_monthly_cents",
              "max_term_months",
              "authorization_ref"
            ]
          }
        },
        "required": [
          "host"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "intent_id": {
            "type": [
